# Cloudflare Pages reads this from the site root. It replaces the `headers()`
# block in next.config.ts, which Next drops when output is 'export'.

# The tour preloads 120 immutable frames; let the browser keep them.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Content-hashed by the build, so the name changes whenever the bytes do.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
